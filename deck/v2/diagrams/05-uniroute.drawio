tyle="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;fontSize=12;fontColor=#000000;arcSize=10;" vertex="1" parent="1"><mxGeometry x="601" y="758" width="250" height="56" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;M4&lt;/b&gt;&amp;nbsp;&amp;nbsp;Traffic drift&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#555555&#x27;&gt;re-run S5 on fresh prompts · regroup labels · $0&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;fontSize=12;fontColor=#000000;arcSize=10;" vertex="1" parent="1"><mxGeometry x="879" y="758" width="250" height="56" as="geometry"/></mxCell><mxCell id="c48" value="Blue: offline, free &amp;nbsp;·&amp;nbsp; orange: paid API calls &amp;nbsp;·&amp;nbsp; green: online &amp;nbsp;·&amp;nbsp; grey: maintenance &amp;nbsp;·&amp;nbsp; bold border: core objects (fingerprints Ψ, router artifact, routing score)" style="text;html=1;fontSize=11;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="838" width="1120" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>