<mxfile host="Metis-Auto v2 design"><diagram id="UniRoute" name="UniRoute"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="(1) Prepare the data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1120" height="100" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;S1&lt;/b&gt;&amp;nbsp;&amp;nbsp;Clean prompts&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#555555&#x27;&gt;last user message + 2 turns · redact · de-duplicate&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fontColor=#000000;arcSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="88" width="300" height="56" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;S2&lt;/b&gt;&amp;nbsp;&amp;nbsp;Split by conversation&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#555555&#x27;&gt;train 209,109 (unlabeled) · validation 800 · test 300&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fontColor=#000000;arcSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="88" width="300" height="56" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;S3&lt;/b&gt;&amp;nbsp;&amp;nbsp;Register models and costs&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#555555&#x27;&gt;candidates · anchor · ĉ(h) scaled to 0–1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fontColor=#000000;arcSize=10;" vertex="1" parent="1"><mxGeometry x="810" y="88" width="300" height="56" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="(2) Learn prompt types (free)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="360" height="290" as="geometry"/></mxCell><mxCell id="c8" value="(3) Fingerprint every model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="400" y="170" width="360" height="290" as="geometry"/></mxCell><mxCell id="c9" value="(4) Choose settings on validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="780" y="170" width="360" height="290" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;S4&lt;/b&gt;&amp;nbsp;&amp;nbsp;Embed train prompts&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#555555&#x27;&gt;frozen multilingual model, run locally&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fon