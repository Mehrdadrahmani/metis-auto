geometry"/></mxCell><mxCell id="c79" value="3.00 · 15.00" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#d0d0d0;fillColor=#ffffff;align=right;spacingLeft=8;spacingRight=8;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="350" y="698" width="150" height="30" as="geometry"/></mxCell><mxCell id="c80" value="0.0075" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#d0d0d0;fillColor=#ffffff;align=right;spacingLeft=8;spacingRight=8;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="500" y="698" width="150" height="30" as="geometry"/></mxCell><mxCell id="c81" value="Judge (gpt-5.x class)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#d0d0d0;fillColor=#ffffff;align=left;spacingLeft=8;spacingRight=8;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="728" width="190" height="30" as="geometry"/></mxCell><mxCell id="c82" value="grades answers" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#d0d0d0;fillColor=#ffffff;align=left;spacingLeft=8;spacingRight=8;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="230" y="728" width="120" height="30" as="geometry"/></mxCell><mxCell id="c83" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#d0d0d0;fillColor=#ffffff;align=right;spacingLeft=8;spacingRight=8;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="350" y="728" width="150" height="30" as="geometry"/></mxCell><mxCell id="c84" value="0.002–0.006" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#d0d0d0;fillColor=#ffffff;align=right;spacingLeft=8;spacingRight=8;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="500" y="728" width="150" height="30" as="geometry"/></mxCell><mxCell id="c85" value="One call ≈ 1,640 input + 174 output tokens (sample average). No prompt-cache discount assumed, so real costs are likely lower. The strong anchor costs ~20–30× a cheap model." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="765" width="620" height="40" as="geometry"/></mxCell><mxCell id="c86" value="(4) How calls are counted (spec §9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="690" y="510" width="530" height="300" as="geometry"/></mxCell><mxCell id="c87" value="N = models · N_val = 400 · N_te = 300 · J = 2 (pairwise order swap)&lt;br&gt;&lt;br&gt;&lt;b&gt;Generation&lt;/b&gt; = N × (N_val + N_te)&lt;br&gt;&lt;b&gt;Judge, pointwise&lt;/b&gt; = N × (N_val + N_te)&lt;br&gt;&lt;b&gt;Judge, pairwise&lt;/b&gt; = (N − 1) × (N_val + N_te) × J" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;fontSize=12;fontColor=#000000;arcSize=10;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="548" width="490" height="120" as="geometry"/></mxCell><mxCell id="c88" value="&lt;b&gt;Later: add a new model (no retraining)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#555555&#x27;&gt;pointwise: 2 × N_val = 800 calls ≈ $1–3 &amp;nbsp;·&amp;nbsp; pairwise: N_val × (1 + J) = 1,200 calls ≈ $1.5–5&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=12;fontColor=#000000;arcSize=10;" vertex="1" parent="1"><mxGeometry x="710" y="686" width="490" height="56" as="geometry"/></mxCell><mxCell id="c89" value="&lt;b&gt;Free forever after&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#555555&#x27;&gt;remove a model · price change · new λ · re-clustering: $0&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fontColor=#000000;arcSize=10;" vertex="1" parent="1"><mxGeometry x="710" y="750" width="490" height="46" as="geometry"/></mxCell><mxCell id="c90" value="Blue: free · orange: paid API calls · green: future model additions · yellow: total" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="822" width="1200" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>