<mxfile host="Metis-Auto v2 design"><diagram id="Offline build" name="Offline build"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Offline build: UNIROUTE_PIPELINE.md S1–S12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;strokeColor=#999999;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1060" height="1200" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;S1&lt;/b&gt; Ingest &amp;amp; clean&lt;br&gt;last user msg + ≤ 2 turns · redact secrets · language tag · de-duplicate" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="60" width="520" height="55" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;S2&lt;/b&gt; Split by conversation (never by turn)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="140" width="420" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;S_tr&lt;/b&gt; train&lt;br&gt;everything else (≥ 5,000)&lt;br&gt;&lt;b&gt;unlabeled&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="230" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;S_val&lt;/b&gt; validation&lt;br&gt;400 labeled" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="210" width="180" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;S_cal&lt;/b&gt;&lt;br&gt;100 human items ⊂ S_val" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="570" y="210" width="180" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;S_te&lt;/b&gt; test&lt;br&gt;300 labeled&lt;br&gt;&lt;b&gt;locked until S11&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="790" y="210" width="230" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;S3&lt;/b&gt; Model registry · cost per model (normalized 0–1) · anchor (pairwise) · holdout models (experiment mode)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="305" width="520" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;S4&lt;/b&gt; Embed all prompts&lt;br&gt;local multilingual embedder" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="230" height="55" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;S5&lt;/b&gt; K-means on S_tr&lt;br&gt;K ∈ {1} ∪ {3 … N_val/50}&lt;br&gt;≥ 50 val prompts per cluster" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="230" height="75" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;S6&lt;/b&gt; Generate answers on S_val ∪ S_te&lt;br&gt;every model, once, cached" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="400" y="380" width="330" height="55" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Pilot (§P)&lt;/b&gt; 4 models · 200 val · 150 test&lt;br&gt;judge &lt;b&gt;both&lt;/b&gt; ways · humans label S_cal&lt;br&gt;criteria: A cross-eval · B human agreement&lt;br&gt;C stability · D separability · tie → pointwise" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="770" y="370" width="290" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;S7&lt;/b&gt; Judge (chosen method)&lt;br&gt;PT: score 1–10, pass ≥ τ&lt;br&gt;PW: vs frozen anchor, both orders" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="400" y="460" width="330" height="75" as="geometry"/></mxCell><mxCell id="c14" value="Judge–human&lt;br&gt;agreement ≥ 75%?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="470" y="560" width="190" height="90" as="geometry"/></mxCell><mxCell id="c15" value="Revise rubric / τ" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="760" y="580" width="160" height="45" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;S8&lt;/b&gt; Fingerprints Ψ from S_val only&lt;br&gt;PT: fail rate, smoothing α = 2&lt;br&gt;PW: Bradley–Terry P(lose to anchor)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="680" width="470" height="70" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;S9&lt;/b&gt; Choose K: split-validation on S_val (5 halvings), max deferral area" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="775" width="470" height="45" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;S10&lt;/b&gt; Choose λ on S_val: quality target or cost budget" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="845" width="470" height="45" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;S11&lt;/b&gt; Evaluate on S_te (first and only use)&lt;br&gt;UniRoute vs always-best · always-cheapest · ZeroRouter · K-NN&lt;br&gt;deferral area · QNC · similarity to production · experiment mode" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="330" y="915" width="470" height="75" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;S12&lt;/b&gt; Router artifact (versioned)&lt;br&gt;method · embedder · K, centroids, names · Ψ · ĉ · λ · hashes" style="whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="1015" width="470" height="65" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#888888;fontColor=#555555;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source