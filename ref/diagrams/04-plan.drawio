<mxfile host="Metis-Auto v2 design"><diagram id="Plan" name="Plan"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;0 ✓ Research &amp;amp; design&lt;/b&gt;&lt;br&gt;v1 design · switch to the&lt;br&gt;UniRoute pipeline spec&lt;br&gt;&lt;i&gt;$0 · done&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="160" height="150" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;1 Prepare (now)&lt;/b&gt;&lt;br&gt;code for S1–S12 with caching&lt;br&gt;dry run on sample data, no paid calls&lt;br&gt;pick embedder&lt;br&gt;&lt;i&gt;$0 · ~1 week&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="160" height="150" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;2 Full data in&lt;/b&gt;&lt;br&gt;S1–S5: clean, split,&lt;br&gt;embed, cluster&lt;br&gt;recompute budget&lt;br&gt;&lt;i&gt;$0 · 1–2 days&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="160" height="150" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;3 Pilot (§P)&lt;/b&gt;&lt;br&gt;4 models · 200 val · 150 test&lt;br&gt;both judge methods&lt;br&gt;100 human labels&lt;br&gt;&lt;i&gt;~$9–24 · ~1 week&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="60" width="160" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;4 Full build&lt;/b&gt;&lt;br&gt;S6–S12 with the&lt;br&gt;chosen method&lt;br&gt;5 models · 400 val · 300 test&lt;br&gt;&lt;i&gt;~$7–24 · ~1 week&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="740" y="60" width="160" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;5 Gateway&lt;/b&gt;&lt;br&gt;rules · cache · router&lt;br&gt;failover · checks · traces&lt;br&gt;&lt;i&gt;$0 · ~1 week&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="920" y="60" width="160" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;6 Evaluate &amp;amp; report&lt;/b&gt;&lt;br&gt;S11 on locked test&lt;br&gt;dashboard · report&lt;br&gt;&lt;i&gt;~$1–2 · 2–3 days&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1100" y="60" width="160" height="150" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="Project plan (v2): we wait for the full dataset before any paid API call" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1240" height="30" as="geometry"/></mxCell><mxCell id="c15" value="Full dataset arrives" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="200" y="250" width="160" height="40" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c15" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="Gate before full build:&lt;br&gt;judge–human ≥ 75%, method chosen" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="920" y="250" width="160" height="50" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#888888;fontColor=#555555;" edge="1" parent="1" source="c17" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="Gate before pilot:&lt;br&gt;you approve the budget" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="250" width="160" height="50" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#888888;fontColor=#555555;" edge="1" parent="1" source="c19" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Total API cost:&lt;/b&gt; ~$17–50 estimated, &lt;b&gt;$60 planned&lt;/b&gt; (recomputed from the full data before any paid call).&lt;br&gt;Phase 5 can start in parallel with phases 3–4.  Pilot answers and grades are reused by the full build." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="1240" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>